// Prisma schema for the talent show voting app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contestant {
  id        String   @id @default(cuid())
  name      String
  act       String?
  photoUrl  String?
  order     Int      @default(0)
  votes     Int      @default(0)
  createdAt DateTime @default(now())
}
