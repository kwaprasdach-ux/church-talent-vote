generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contestant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  act       String?
  photoUrl  String?
  order     Int      @default(0)
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  Vote      Vote[]
}

model Vote {
  id           String     @id @default(cuid())
  reference    String     @unique  // Paystack reference — prevents replay attacks
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  quantity     Int
  amountGhs    Float
  createdAt    DateTime   @default(now())
}
